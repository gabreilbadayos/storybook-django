# Multi-platform environment variables
# Copy to .env and customize

# Core
DEBUG=False
SECRET_KEY=your-super-secret-django-key-generate-at-djecrety.ir
ALLOWED_HOSTS=.pythonanywhere.com  # PythonAnywhere: yourusername.pythonanywhere.com

# Database options
# DATABASE_URL=postgresql://user:pass@host:port/dbname  # Render/Railway Postgres
# For PythonAnywhere MySQL: configure in settings.py or use SQLite default

# Platform specific
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com  # Render
# PA_USERNAME=yourusername  # PythonAnywhere (optional)

# Features
OPENAI_API_KEY=sk-your-openai-key  # Optional AI moral lessons
